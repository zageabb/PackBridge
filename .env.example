PACKBRIDGE_HOST=0.0.0.0
PACKBRIDGE_PORT=5085
PACKBRIDGE_SECRET_KEY=change-me
PACKBRIDGE_DATABASE_URL=sqlite:///packbridge.sqlite3
PACKBRIDGE_DATA_ROOT=./data
PACKBRIDGE_KNOWLEDGE_ROOT=./knowledge
PACKBRIDGE_TEMPLATE_ROOT=./ssd_templates
PACKBRIDGE_OLLAMA_URL=http://192.168.1.249:11434
PACKBRIDGE_OLLAMA_MODEL=qwen3:14b
PACKBRIDGE_MAX_UPLOAD_MB=100
PACKBRIDGE_AUTO_CREATE_DB=1

# Optional scanned-PDF fallback. Values: off | tesseract
PACKBRIDGE_OCR_MODE=off
PACKBRIDGE_OCR_LANGUAGE=eng

# Optional local access control
PACKBRIDGE_AUTH_ENABLED=0
PACKBRIDGE_USERS_FILE=~/.config/packbridge/users.json
PACKBRIDGE_COOKIE_SECURE=0

# Operations
PACKBRIDGE_LOG_ROOT=~/.local/state/packbridge
PACKBRIDGE_LOG_LEVEL=INFO
PACKBRIDGE_LOG_MAX_BYTES=5000000
PACKBRIDGE_LOG_BACKUP_COUNT=5
PACKBRIDGE_BACKUP_ROOT=~/.local/share/packbridge/backups
PACKBRIDGE_RETENTION_DAYS=90

# Production SSD release gates. Keep disabled until formal SAP acceptance.
PACKBRIDGE_SAP_OUTPUT_APPROVED=0
PACKBRIDGE_SAP_SOCS_ONLY_APPROVED=0
PACKBRIDGE_SAP_MACRO_FREE_APPROVED=0
