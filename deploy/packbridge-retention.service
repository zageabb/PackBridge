[Unit]
Description=PackBridge retention cleanup
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/ollama-chat/PackBridge
EnvironmentFile=-%h/.config/packbridge/packbridge.env
ExecStart=%h/ollama-chat/PackBridge/.venv/bin/python -m flask --app wsgi:application packbridge retention --apply
ExecStart=%h/ollama-chat/PackBridge/.venv/bin/python -m flask --app wsgi:application packbridge backup-prune --apply
